# From your app's page on marketplace.gohighlevel.com -> "Client Keys"
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# Must exactly match the Redirect URI you register on the marketplace app page
GHL_REDIRECT_URI=https://your-domain.example.com/oauth/callback

# Shared secret you invent yourself and paste into the action's "Headers" field
# in the marketplace UI (e.g. header "x-action-secret"). Used to verify that
# POSTs to /actions/nearest-location really came from GHL and not the public internet.
ACTION_SHARED_SECRET=change-me

# If set, the app writes the result onto this custom field key on the contact
# (create the custom field in GHL first, e.g. "nearest_location").
# Leave blank to skip writing back to the contact.
GHL_NEAREST_LOCATION_FIELD_KEY=

PORT=3000
